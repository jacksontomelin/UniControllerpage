# ═══════════════════════════════════════════════════════
#  Serviço de tickets — UniController
# ═══════════════════════════════════════════════════════

# Para onde chegam os avisos de nova solicitação
DESTINO_EMAIL=jk2706@gmail.com

# ── E-MAIL VIA GMAIL ───────────────────────────────────
# Exige verificação em duas etapas ativa na conta e uma
# SENHA DE APP gerada em: myaccount.google.com/apppasswords
# (a senha normal do Gmail NÃO funciona aqui)
SMTP_SERVICE=gmail
SMTP_USER=jk2706@gmail.com
SMTP_PASS=abcd efgh ijkl mnop

# Nome que o cliente vê como remetente.
# O Gmail só aceita um endereço diferente do SMTP_USER se ele
# estiver cadastrado e verificado em "Enviar e-mail como".
SMTP_FROM=UniController <jk2706@gmail.com>

# Para onde vão as respostas do cliente
REPLY_TO=jk2706@gmail.com

# ── Site ───────────────────────────────────────────────
SITE_URL=https://unicontroller.com.br
CORS_ORIGINS=https://unicontroller.com.br,https://www.unicontroller.com.br

# ── Área interna ───────────────────────────────────────
# Gere um valor longo e aleatório
ADMIN_TOKEN=troque-por-uma-chave-longa-aleatoria

PORT=3000

# ── Alternativa: SMTP do próprio domínio (KingHost) ────
# Comente as linhas SMTP_SERVICE/SMTP_USER/SMTP_PASS acima e use:
# SMTP_HOST=smtp.kinghost.com.br
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=suporte@unicontroller.com.br
# SMTP_PASS=senha-do-email
# SMTP_FROM=UniController <suporte@unicontroller.com.br>

# ── CAPTCHA Cloudflare Turnstile ───────────────────────
# Gere o par de chaves em dash.cloudflare.com → Turnstile → Add site
# A chave PÚBLICA vai no index.html (window.UC_TURNSTILE)
# A chave SECRETA vai aqui. Sem ela, a verificação é ignorada.
TURNSTILE_SECRET=
